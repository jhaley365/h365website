# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000
# Random long string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin login (single shared admin account for the management UI) ---
ADMIN_USERNAME=admin
# Bcrypt hash of the admin password. Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=

# --- Database ---
DB_PATH=./data/birthdays.db

# --- Outbound email (SMTP) ---
# Works with Office 365, Google Workspace, Amazon SES SMTP, SendGrid SMTP, etc.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# "Display Name <address@domain.com>" used as the From header on all outgoing mail
MAIL_FROM="HR <hr@theconcreteco.com>"

# --- Recipients ---
# Where the birthday announcement itself is sent (e.g. a company-wide distribution list)
BIRTHDAY_ANNOUNCEMENT_TO=theconcreteco@theconcreteco.com
# Where the daily management summary is sent. Comma-separate multiple addresses.
MANAGEMENT_SUMMARY_TO=hr@theconcreteco.com

# --- Scheduling ---
# IANA timezone the 8:00 AM send time is evaluated in.
TIMEZONE=America/New_York
SEND_HOUR=8
SEND_MINUTE=0

COMPANY_NAME="The Concrete Company"
