<!doctype html>
<html lang="en">
<head>
  <title>Log in — Employee Birthdays</title>
  <%- include('partials/head') %>
</head>
<body class="login-body">
  <main class="login-card">
    <div class="login-brand">
      <svg width="36" height="36" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <g transform="rotate(-28 24 24)">
          <ellipse cx="24" cy="24" rx="18" ry="8.5" stroke="#2f6bff" stroke-width="2.2" fill="none"></ellipse>
          <circle cx="42" cy="24" r="3.2" fill="#2f6bff"></circle>
        </g>
        <circle cx="24" cy="24" r="4.4" fill="#0c111e"></circle>
      </svg>
      <h1>Employee Birthdays</h1>
    </div>
    <% if (error) { %>
      <p class="alert alert-error"><%= error %></p>
    <% } %>
    <form method="POST" action="/login">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" autocomplete="username" required />

      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required />

      <button type="submit" class="btn btn-primary">Log in</button>
    </form>
  </main>
</body>
</html>
