<!doctype html>
<html lang="en">
<head>
  <title>Dashboard — Employee Birthdays</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="container">
    <h1>Dashboard</h1>

    <section class="card-grid">
      <div class="stat-card">
        <span class="stat-number"><%= totalEmployees %></span>
        <span class="stat-label">Employees tracked</span>
      </div>
      <div class="stat-card">
        <span class="stat-number"><%= todaysBirthdays.length %></span>
        <span class="stat-label">Birthday(s) today</span>
      </div>
      <div class="stat-card">
        <span class="stat-number"><%= summarySentToday ? 'Yes' : 'Not yet' %></span>
        <span class="stat-label">Management summary sent today</span>
      </div>
    </section>

    <p class="muted">
      Announcements and the daily management summary are sent automatically at <%= sendTime %>
      (<%= timezone %>).
    </p>

    <section>
      <h2>🎉 Today's birthdays</h2>
      <% if (todaysBirthdays.length === 0) { %>
        <p class="muted">No employee birthdays today.</p>
      <% } else { %>
        <ul class="simple-list">
          <% todaysBirthdays.forEach(function(e) { %>
            <li><%= e.first_name %> <%= e.last_name %> — <%= e.email %></li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section>
      <h2>Upcoming birthdays</h2>
      <% if (upcoming.length === 0) { %>
        <p class="muted">No employees yet. <a href="/employees/new">Add one</a>.</p>
      <% } else { %>
        <table class="data-table">
          <thead>
            <tr><th>Name</th><th>Birthday</th><th>Days away</th></tr>
          </thead>
          <tbody>
            <% upcoming.forEach(function(e) { %>
              <tr>
                <td><%= e.first_name %> <%= e.last_name %></td>
                <td><%= e.monthDayDisplay %></td>
                <td><%= e.daysUntil === 0 ? 'Today' : e.daysUntil + ' days' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

    <p><a class="btn btn-primary" href="/employees">Manage employees</a></p>
  </main>
</body>
</html>
