<!doctype html>
<html lang="en">
<head>
  <title>Employees — Employee Birthdays</title>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/nav') %>
  <main class="container">
    <div class="page-header">
      <h1>Employees</h1>
      <a class="btn btn-primary" href="/employees/new">+ Add employee</a>
    </div>

    <% if (employees.length === 0) { %>
      <p class="muted">No employees yet. <a href="/employees/new">Add the first one</a>.</p>
    <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>First name</th>
            <th>Last name</th>
            <th>Email</th>
            <th>Birth date</th>
            <th>Today?</th>
            <th>Announced this year</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% employees.forEach(function(e) { %>
            <tr class="<%= e.isBirthdayToday ? 'row-highlight' : '' %>">
              <td><%= e.first_name %></td>
              <td><%= e.last_name %></td>
              <td><%= e.email %></td>
              <td><%= e.birthDateDisplay %></td>
              <td><%= e.isBirthdayToday ? '🎂 Yes' : '' %></td>
              <td><%= e.announcedThisYear ? 'Yes' : 'No' %></td>
              <td class="row-actions">
                <a href="/employees/<%= e.id %>/edit">Edit</a>
                <form method="POST" action="/employees/<%= e.id %>/delete" class="inline-form"
                      onsubmit="return confirm('Delete <%= e.first_name %> <%= e.last_name %>? This cannot be undone.');">
                  <button type="submit" class="link-button danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </main>
</body>
</html>
